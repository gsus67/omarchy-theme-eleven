{
  "schemaVersion": 1,
  "id": "io.github.gsus67.omarchy-theme-eleven",
  "name": "Eleven",
  "version": "0.1.0",
  "author": "gsus67 and contributors",
  "license": "MIT",
  "description": "A reversible Windows-inspired theme and Start menu, using existing Omarchy components.",
  "kinds": [
    "bar-widget",
    "menu",
    "service",
    "panel"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "start/Start.qml",
    "menu": "start/MenuBridge.qml",
    "service": "Lifecycle.qml",
    "panel": "start/SettingsWindow.qml"
  },
  "barWidget": {
    "displayName": "Eleven Start",
    "description": "Search and pinned applications in a Windows-inspired layout.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "left"
  }
}
